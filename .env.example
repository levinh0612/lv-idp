# Copy file này thành .env (cp .env.example .env). KHÔNG commit .env.
IDP_DB_NAME=idp
IDP_DB_USER=idp
IDP_DB_PASSWORD=change-me

# Cổng trên máy host (5432 đã bị Postgres local chiếm nên dùng 5433)
IDP_DB_PORT=5434

IDP_REDIS_PORT=6379
IDP_SMTP_PORT=1025
IDP_MAILPIT_UI_PORT=8025

# Dùng cho app (bước 6)
IDP_DB_URL=jdbc:postgresql://localhost:5434/idp